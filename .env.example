DATABASE_URL=postgres://user:password@localhost:5432/gallery
# Long random string: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
# Generate: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
# IMPORTANT: escape every $ as \$ in .env (Next.js expands variables), e.g. \$2a\$10\$abc...
ADMIN_PASSWORD_HASH=
# Dev-only fallback if no hash is set (plain text, compared in constant time)
ADMIN_PASSWORD=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CURRENCY=USD
